{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "regions": [
    "iad1"
  ],
  "functions": {
    "src/app/api/stock/[ticker]/route.ts": {
      "maxDuration": 60
    },
    "src/app/api/cron/radar/route.ts": {
      "maxDuration": 300
    }
  },
  "crons": [
    {
      "path": "/api/cron/ranking",
      "schedule": "0 22 * * *"
    },
    {
      "path": "/api/cron/radar",
      "schedule": "0 13 * * 1"
    }
  ]
}